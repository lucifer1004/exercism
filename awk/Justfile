setup:
    @nix develop --command echo "AWK environment ready"

clean:
    @echo "No build artifacts to clean for AWK"

format:
    @echo "⚠️  No standard formatter available for AWK"

test project:
    nix develop --command sh -c "cd {{project}} && bats test-*.bats"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if ls "$dir"/test-*.bats >/dev/null 2>&1; then
            project="${dir%/}"
            echo "Testing $project..."
            just test "$project"
        fi
    done
