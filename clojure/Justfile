setup:
    @nix develop --command echo "Clojure environment ready"

clean:
    @find . -type d -name "target" -exec rm -rf {} + 2>/dev/null || true

format:
    nix develop --command sh -c "find . -name '*.clj' -o -name '*.cljs' -o -name '*.cljc' | xargs -r cljfmt fix"

test project:
    nix develop --command sh -c "cd {{project}} && lein test"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/project.clj" ]; then
            project="${dir%/}"
            echo "Testing $project..."
            just test "$project"
        fi
    done
