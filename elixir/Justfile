setup:
    @nix develop --command echo "Elixir environment ready"

clean:
    @find . -type d -name "_build" -exec rm -rf {} + 2>/dev/null || true
    @find . -type d -name "deps" -exec rm -rf {} + 2>/dev/null || true
    @find . -name "*.beam" -type f -delete 2>/dev/null || true

test project:
    nix develop --command sh -c "cd {{project}} && mix test"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/mix.exs" ]; then
            echo "Testing ${dir%/}..."
            nix develop --command sh -c "cd $dir && mix test"
        fi
    done

