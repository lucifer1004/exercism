setup:
    @nix develop --command echo "Elm environment ready"

clean:
    @find . -type d -name "elm-stuff" -exec rm -rf {} + 2>/dev/null || true

format:
    nix develop --command sh -c "find . -name '*.elm' -not -path './.*' -not -path '*/elm-stuff/*' -exec elm-format --yes {} +"

test project:
    nix develop --command sh -c "cd {{project}} && elm-test"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/elm.json" ]; then
            project="${dir%/}"
            echo "Testing $project..."
            just test "$project"
        fi
    done
