setup:
    @nix develop --command echo "Go environment ready"

clean:
    @find . -name "go.sum" -type f -delete 2>/dev/null || true

format:
    #!/usr/bin/env bash
    for dir in */; do
        if [ -f "$dir/go.mod" ]; then
            nix develop --command sh -c "cd $dir && go fmt ./..."
        fi
    done

test project:
    nix develop --command sh -c "cd {{project}} && go test"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/go.mod" ] || ls "$dir"/*_test.go >/dev/null 2>&1; then
            echo "Testing ${dir%/}..."
            nix develop --command sh -c "cd $dir && go test"
        fi
    done
