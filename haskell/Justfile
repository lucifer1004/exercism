setup:
    @nix develop --command echo "Haskell environment ready"

clean:
    @find . -type d -name ".stack-work" -exec rm -rf {} + 2>/dev/null || true
    @find . -type d -name "dist-newstyle" -exec rm -rf {} + 2>/dev/null || true

test project:
    nix develop --command sh -c "cd {{project}} && stack test"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/stack.yaml" ] || [ -f "$dir/package.yaml" ]; then
            echo "Testing ${dir%/}..."
            nix develop --command sh -c "cd $dir && stack test"
        fi
    done
