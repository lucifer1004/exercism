setup:
    @nix develop --command sh -c "julia --project=. -e 'using Pkg; Pkg.instantiate()'"

clean:
    @find . -type d -name ".julia" -exec rm -rf {} + 2>/dev/null || true

format: setup
    nix develop --command sh -c "julia --project=. -e 'using JuliaFormatter; format(\".\")'"

test project:
    nix develop --command sh -c "cd {{project}} && julia runtests.jl"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/runtests.jl" ]; then
            project="${dir%/}"
            echo "Testing $project..."
            just test "$project"
        fi
    done
