setup:
    @nix develop --command echo "Julia environment ready"

clean:
    @find . -type d -name ".julia" -exec rm -rf {} + 2>/dev/null || true

test project:
    nix develop --command sh -c "cd {{project}} && julia runtests.jl"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/runtests.jl" ]; then
            echo "Testing ${dir%/}..."
            nix develop --command sh -c "cd $dir && julia runtests.jl"
        fi
    done
