setup:
    @test -f mars.jar || wget -O mars.jar https://github.com/dpetersanderson/MARS/releases/download/v.4.5.1/Mars4_5.jar

clean:
    @rm -f mars.jar 2>/dev/null || true

format:
    @echo "⚠️  No standard formatter available for MIPS assembly"

test project: setup
    nix develop --command sh -c "cd {{project}} && java -jar ../mars.jar nc runner.mips impl.mips"

test-all: setup
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/runner.mips" ]; then
            project="${dir%/}"
            echo "Testing $project..."
            just test "$project"
        fi
    done
