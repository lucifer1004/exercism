setup:
    @nix develop --command echo "OCaml environment ready"

clean:
    @find . -type d -name "_build" -exec rm -rf {} + 2>/dev/null || true

test project:
    nix develop --command sh -c "cd {{project}} && dune test"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/dune" ] || [ -f "$dir/dune-project" ]; then
            echo "Testing ${dir%/}..."
            nix develop --command sh -c "cd $dir && dune test"
        fi
    done
