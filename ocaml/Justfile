setup:
    @nix develop --command echo "OCaml environment ready"

clean:
    @find . -type d -name "_build" -exec rm -rf {} + 2>/dev/null || true

format:
    nix develop --command sh -c "find . -name '*.ml' -o -name '*.mli' | grep -v '_build' | xargs -r ocamlformat --inplace"

test project:
    nix develop --command sh -c "cd {{project}} && dune test"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/dune" ] || [ -f "$dir/dune-project" ]; then
            project="${dir%/}"
            echo "Testing $project..."
            just test "$project"
        fi
    done
