setup:
    @nix develop --command echo "Python environment ready"

clean:
    @find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
    @find . -type d -name ".pytest_cache" -exec rm -rf {} + 2>/dev/null || true

format:
    nix develop --command sh -c "find . -name '*.py' -not -path './.*' -exec black {} +"

test project:
    nix develop --command sh -c "cd {{project}} && pytest"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if ls "$dir"/*_test.py >/dev/null 2>&1 || ls "$dir"/test_*.py >/dev/null 2>&1; then
            project="${dir%/}"
            echo "Testing $project..."
            just test "$project"
        fi
    done
