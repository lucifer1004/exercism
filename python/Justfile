test project:
    nix develop --command sh -c "cd {{project}} && pytest"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if ls "$dir"/*_test.py >/dev/null 2>&1 || ls "$dir"/test_*.py >/dev/null 2>&1; then
            echo "Testing ${dir%/}..."
            nix develop --command sh -c "cd $dir && pytest"
        fi
    done

