setup:
    @nix develop --command echo "Racket environment ready"

clean:
    @echo "Racket: no build artifacts to clean"

format:
    @echo "ℹ️  Racket formatting requires fmt package"
    @echo "    Run: raco pkg install fmt && raco fmt -i ."

test project:
    nix develop --command sh -c "cd {{project}} && raco test ."

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if ls "$dir"/*-test.rkt >/dev/null 2>&1 || ls "$dir"/*_test.rkt >/dev/null 2>&1; then
            project="${dir%/}"
            echo "Testing $project..."
            just test "$project"
        fi
    done
