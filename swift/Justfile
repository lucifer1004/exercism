# Swift Exercism projects
# Note: Requires Swift to be installed on your system
# See README.md for installation instructions

# Verify Swift is installed
setup:
    @swift --version || (echo "❌ Swift not installed. See README.md" && exit 1)

# Clean build artifacts
clean:
    @find . -type d -name ".build" -exec rm -rf {} + 2>/dev/null || true
    @find . -name "Package.resolved" -type f -delete 2>/dev/null || true

# Format code
format:
    @echo "ℹ️  Swift formatting requires swift-format tool"
    @echo "    Install: brew install swift-format (on macOS)"
    @echo "    Then run: swift-format -i -r ."

# Test a specific project
test project:
    cd {{project}} && swift test

# Test all projects
test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if [ -f "$dir/Package.swift" ]; then
            echo "Testing ${dir%/}..."
            (cd "$dir" && swift test)
        fi
    done
