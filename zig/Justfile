setup:
    @nix develop --command echo "Zig environment ready"

clean:
    @find . -name "zig-cache" -type d -exec rm -rf {} + 2>/dev/null || true

format:
    nix develop --command sh -c "find . -name '*.zig' -not -path './*/zig-cache/*' -not -path './.*' -exec zig fmt {} +"

test project:
    nix develop --command sh -c "cd {{project}} && zig test test*"

test-all:
    #!/usr/bin/env bash
    set -e
    for dir in */; do
        if ls "$dir"/test_*.zig >/dev/null 2>&1 || ls "$dir"/test*.zig >/dev/null 2>&1; then
            project="${dir%/}"
            echo "Testing $project..."
            just test "$project"
        fi
    done
